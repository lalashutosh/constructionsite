# Copy to .env (never commit). DATASET_ROOT = folder that contains questions.jsonl and data/
DATASET_ROOT=/Users/YOU/Downloads/junction-dataset-preview

# LLM: none (default, reported runs) | verda (dev planner) | featherless (backup) | anthropic (live demo only)
LLM_PROVIDER=none
VERDA_API_KEY=
VERDA_BASE_URL=
VERDA_MODEL_FAST=
VERDA_MODEL_STRONG=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL_FAST=
FEATHERLESS_MODEL_STRONG=
ANTHROPIC_API_KEY=

# Compute and weights
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
HF_TOKEN=

# Budget guards (calls that would exceed a cap are refused)
BUDGET_VERDA_USD=150
# USD per 1M tokens (check the Verda console)
VERDA_PRICE_FAST_IN=0.15
VERDA_PRICE_FAST_OUT=0.60
VERDA_PRICE_STRONG_IN=2.00
VERDA_PRICE_STRONG_OUT=10.00
BUDGET_FEATHERLESS_USD=20
BUDGET_ANTHROPIC_USD=0
