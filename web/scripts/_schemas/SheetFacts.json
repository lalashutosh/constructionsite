    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sheet_type": {
      "default": "unknown",
      "enum": [
        "floor_plan",
        "elevation",
        "section",
        "site_plan",
        "detail",
        "multi_view",
        "schedule",
        "not_a_plan",
        "unknown"
      ],
      "title": "Sheet Type",
      "type": "string"
    },
    "legible": {
      "default": true,
      "title": "Legible",
      "type": "boolean"
    },
    "legibility_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legibility Note"
    },
    "width_px": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width Px"
    },
    "height_px": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height Px"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "title": "Elements",
      "type": "array"
    },
    "scale": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScaleInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
