    "printed_areas": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Printed Areas",
      "type": "array"
    },
    "extras": {
      "additionalProperties": true,
      "title": "Extras",
      "type": "object"
    }
