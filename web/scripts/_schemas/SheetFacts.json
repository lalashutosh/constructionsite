        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "credit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credit"
        }
      },
      "required": [
        "file"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ScaleAnchor": {
      "properties": {
        "kind": {
          "enum": [
            "scale_bar",
            "dimension",
            "printed_ratio",
            "printed_area",
            "door_prior",
            "user"
